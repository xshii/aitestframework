name: NPU算子基础测试
plans:
- name: TestConv2D
  tests:
  - inference/operators/test_conv2d.py
- bundle: npu_exact
  golden:
    model: npu_model
    version: v1.0
  name: 精确比对Demo
  params:
    addr_shift: 16
    filter_cases:
    - tdd
    operator_name: tdd
    repo_name: repo_a
  target: local
  tests:
  - npu/operators/test_exact_compare_demo.py
