# AITF 配置文件
#
# 复制为 config.yaml 后按需修改:
#   cp config.yaml.example config.yaml
#
# 运行模式（由 server 字段决定）:
#   server 设为本机 IP → 服务器模式（绑定 0.0.0.0，允许远程访问）
#   server 留空或不填 → 单机模式（绑定 127.0.0.1）
#   server 设为远程 IP → 客户端模式（连接远程服务器）

# server: "192.168.1.100"
port: 8080

# DBox 导出功能（实验性）
dbox_enabled: false
# dbox_server: "http://192.168.1.100:9090"
# dbox_upload_path: "/api/upload"
