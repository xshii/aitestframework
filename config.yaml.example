# AITF 配置文件
#
# 复制为 config.yaml 后按需修改:
#   cp config.yaml.example config.yaml
#
# ═══════════════════════════════════════════════════════════════════
# 运行模式（由 server 字段自动判定，无需手动指定 mode）
# ═══════════════════════════════════════════════════════════════════
#
# ┌─────────────────┬────────────┬───────────┬───────────────────────────┐
# │ server 值       │ 模式       │ 绑定地址  │ 说明                      │
# ├─────────────────┼────────────┼───────────┼───────────────────────────┤
# │ 留空 / 不填     │ standalone │ 0.0.0.0   │ 本机即服务器，无远程同步   │
# │ 远程 IP         │ client     │ 127.0.0.1 │ 连接远端服务器，同步数据   │
# │ 本机 IP         │ debug      │ 0.0.0.0   │ 同时充当服务端+客户端      │
# └─────────────────┴────────────┴───────────┴───────────────────────────┘
#
# 示例:
#
#   场景 1 — 单机使用（standalone）:
#     不写 server，或:
#     server: ""
#     port: 8080
#
#   场景 2 — 客户端，连接远程服务器（client）:
#     server: "192.168.1.100"
#     port: 8080
#
#   场景 3 — 本机调试同步流程（debug）:
#     server: "192.168.1.50"   # 填本机实际 IP（非 127.0.0.1）
#     port: 8080
#
# 启动命令:
#   python -m aitf.cli web                       # 读取 config.yaml
#   python -m aitf.cli web --host 0.0.0.0 --port 9090  # 覆盖绑定地址
#   python -m aitf.cli web --debug               # Flask debug 模式
#
# ═══════════════════════════════════════════════════════════════════

# server: "192.168.1.100"
port: 8080

# DBox 导出功能（实验性）
dbox_enabled: false
# dbox_server: "http://192.168.1.100:9090"
# dbox_upload_path: "/api/upload"
