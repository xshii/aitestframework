# =============================================================================
# Comprehensive deps.yaml example — covers every supported feature.
#
# Sections:
#   toolchains:  archive-based deps (compilers, simulators, prebuilt tools)
#   repos:       git repositories (cloned via repo.py)
#   bundles:     named version sets (framework-only, not used by install.py)
#
# Run:
#   python install.py                         # uses ./deps.yaml
#   python install.py path/to/deps.yaml
#
# Same-`order` steps run in parallel; groups run sequentially in ascending
# order. Fractional orders (e.g. 1.5) are supported.
#
# Defaults: DEBUG-level framework logs + tool stdout/stderr streamed live.
# Quieter mode (capture tool output, only show on failure):
#   AITF_TOOL_LOG=capture python install.py
#
# Save tool output to file (instead of streaming):
#   AITF_TOOL_LOG=/tmp/build.log python install.py
#
# Less framework chatter (INFO instead of DEBUG):
#   AITF_LOG_LEVEL=INFO python install.py
# =============================================================================


# =============================================================================
# Toolchains — three acquisition modes
# =============================================================================
toolchains:

  # ---------------------------------------------------------------------------
  # Mode A: pre-staged archive on disk (Tier-1 local_dir)
  #
  # By default the framework looks for filenames matching the convention:
  #   {name}-{version}-{platform}.{ext}   (platform = e.g. linux-x86_64)
  #   {name}-{version}.{ext}              (platform-agnostic)
  # with ext ∈ { tar.gz, tgz, tar.xz, tar.bz2, tar, zip, rar }.
  #
  # To use an explicit filename that doesn't match the convention, set
  # `srcpkg:` — it's resolved relative to `local_dir`.
  # ---------------------------------------------------------------------------
  gcc-arm:
    version: "10.3-2021.10"
    acquire:
      local_dir: "deps/uploads"              # directory to look in
      srcpkg: "gcc-arm-10.3-2021.10.zip"     # explicit filename (optional)
      install_dir: ""                        # default: <build>/cache/<name>
    order: 0

  # ---------------------------------------------------------------------------
  # Mode B: fetch script (Tier-2)
  #
  # Script path is resolved relative to the project root.
  # Invoked as:  bash <script> <version> <install_dir>
  # The script may either drop an archive under install_dir (framework
  # extracts it) or write the unpacked content directly.
  # ---------------------------------------------------------------------------
  ninja:
    version: "1.11.1"
    acquire:
      script: "scripts/fetch_ninja.sh"
      install_dir: ""                        # default: <build>/cache/<name>
    order: 1

  # ---------------------------------------------------------------------------
  # Mode C: external artifact tool (no archive convention required)
  #
  # The framework wgets a small downloader binary (URL/CLI configured in
  # bootstrap.py) and invokes it once per dep. `extract: true` runs system
  # tar/unzip/unrar afterwards on whatever files landed in install_dir.
  #
  # Every yaml field under `artifact_tool:` (other than `extract`) is
  # auto-propagated as a `{name}` placeholder to bootstrap.py's
  # ARTIFACT_TOOL_FLAGS — adding a new placeholder requires no Python edits.
  # ---------------------------------------------------------------------------
  ddk:
    version: "v2026.04"
    acquire:
      artifact_tool:
        extract: true                        # run system tar/unzip after download
        artifact_dir: "ddk/v2026.04"         # → {artifact_dir}
        flavor:   "release"                  # → {flavor}
      install_dir: ""                        # default: <build>/cache/<name>
    order: 2


# =============================================================================
# Repositories — git clone (+ optional build)
#
# Ref is a three-way exclusive choice: branch / tag / commitno.
# Resolution priority when multiple are set: commitno > tag > branch.
#
# Clone strategy:
#   - branch / tag → clone --branch <ref> --single-branch [--depth N]
#   - commitno     → clone --filter=blob:none, then checkout (git ≥ 2.19)
#
# depth: not set → full clone; set to N → shallow clone to N.
# =============================================================================
repos:

  # ---------------------------------------------------------------------------
  # Branch — shallow clone of "main"
  # ---------------------------------------------------------------------------
  models-zoo-main:
    url: "https://github.com/example/models-zoo.git"
    branch: "main"
    depth: 1
    install_dir: ""                          # default: <build>/repos/<name>
    order: 3

  # ---------------------------------------------------------------------------
  # Tag — same fast path as branch
  # ---------------------------------------------------------------------------
  models-zoo-stable:
    url: "https://github.com/example/models-zoo.git"
    tag: "v1.2.0"
    depth: 1
    order: 3                                 # same order as above → parallel

  # ---------------------------------------------------------------------------
  # Commit SHA — partial clone (full history, no blobs until checkout)
  # No `depth` → full history is fetched lazily on demand.
  # ---------------------------------------------------------------------------
  models-zoo-pinned:
    url: "https://github.com/example/models-zoo.git"
    commitno: "abcdef1234567890abcdef1234567890abcdef12"
    order: 4

  # ---------------------------------------------------------------------------
  # Sparse checkout — only the listed paths get materialised on disk.
  # Requires git ≥ 2.27 on the client. Upgrade paths:
  #   Ubuntu  : sudo add-apt-repository ppa:git-core/ppa && sudo apt install git
  #   CentOS7 : sudo yum install https://repo.ius.io/ius-release-el7.rpm epel-release && sudo yum install git236
  #   any     : conda install -c conda-forge git
  # ---------------------------------------------------------------------------
  internal-models:
    url: "https://gitlab.internal/team/models.git"
    branch: "main"
    sparse_checkout:
      - "models/tdd/"
      - "models/fdd/"
    build_script: "scripts/build_internal_models.sh"
    order: 5


# =============================================================================
# Bundles — named version sets (framework-only)
#
# Used by `aitf bundle use <name>` from the framework CLI. The standalone
# install.py does NOT consume bundles; it always installs every entry under
# toolchains:/repos: above.
# =============================================================================
bundles:

  stable-2026q1:
    description: "Verified Q1 2026 toolchain set"
    status: verified                         # verified | testing | deprecated
    toolchains:
      gcc-arm: "10.3-2021.10"
      ddk:     "v2026.04"
    repos:
      models-zoo-stable: "v1.2.0"

  edge-2026q2:
    description: "Cutting-edge for Q2 testing"
    status: testing
    toolchains:
      gcc-arm: "10.3-2021.10"
      ddk:     "v2026.04"
    repos:
      models-zoo-main: "main"

active: stable-2026q1
